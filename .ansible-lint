---
skip_list:
  # We have over a thousand of these, won't fix
  - fqcn-builtins  # Use FQCN for builtin actions.
  # We have dozens of these, won'tfix
  - var-naming[no-role-prefix]
  # This is triggering for the "name" parameter for the container_runner role from Dante... won'tfix
  - var-naming[no-reserved]
  # The run_once rules just forbid "strategy: free" and "run_once: yes" without checking
  # that they're being used together, so they give a lot of false positives.
  - run-once[play]  # Avoid "strategy: free"
  - run-once[task]  # Avoid "run_once: yes"
  # This seems to be biting off more than it can chew.
  - jinja[invalid]

# make warnings fatal
warn_list: []

# opt-in to most of the optional checks, other than name[prefix]
enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner

kinds:
  - playbook: "**/ansible/*.{yaml,yml}"
