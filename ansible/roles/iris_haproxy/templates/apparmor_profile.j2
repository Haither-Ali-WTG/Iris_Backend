# ### This file is deployed by Iris ###


# This is the apparmor profile for the Iris haproxy

# To load this profile, use the command:
#    apparmor_parser -r -W {{ individual_instance_dir }}/apparmor_profile


# For debugging and investigation, we can comment out the section indicated below, then
# reload the profile using the command above; the updated profile will immediately apply
# to the already-running container.

# Once debugging and investigation is concluded, we can either manually revert the
# changes here, or they will be automatically reverted on the next Iris deployment run.


#include <tunables/global>


profile {{ container_name }} flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet tcp,
  network inet udp,
  deny network inet icmp,

  deny network raw,

  deny network packet,

  file,
  deny umount,

  deny /bin/** wl,
  deny /boot/** wl,
  deny /etc/** wl,
  deny /home/** wl,
  deny /lib/** wl,
  deny /lib64/** wl,
  deny /media/** wl,
  deny /mnt/** wl,
  deny /opt/** wl,
  deny /root/** wl,
  deny /sbin/** wl,
  deny /srv/** wl,
  deny /tmp/** wl,
  deny /sys/** wl,
  deny /usr/** wl,

  # deny /dev except /dev/null
  deny /dev/[^n]** wl,
  deny /dev/n[^u]** wl,
  deny /dev/nu[^l]** wl,
  deny /dev/nul[^l]** wl,

  audit /** w,

  /var/run/haproxy/global-state rw,

  /usr/local/sbin/haproxy ix,
  /usr/local/bin/docker-entrypoint.sh ix,

# For debugging and investigation, we can comment out these four lines, then reload the
# profile. The reloaded profile will immediately apply to the already-running container.
  deny /bin/** mrwklx,
  deny /sbin/** mrwklx,
  deny /usr/bin/** mrwklx,
  deny /usr/sbin/** mrwklx,


  deny capability chown,
  deny capability dac_override,
  deny capability setuid,
  deny capability setgid,
  deny capability net_bind_service,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/mem rwklx,
  deny @{PROC}/kmem rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
