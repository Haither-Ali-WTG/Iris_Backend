error_log  /etc/nginx/error.log;
worker_rlimit_nofile 8192;

events {
  worker_connections  4096;  ## Default: 1024
}

http {
  index    index.html;

{% for status in status_codes if status in [200, 400, '200', '400'] %}
  server { 
    listen 80;
    server_name
    {%- for test in tests_list | default([]) -%}
      {%- if status in test.statuses %} {{ test.host }}
      {%- endif -%}
    {%- endfor -%};
    root /public;
    allow all;
    return {{ status }};
  }
{% endfor %}
}